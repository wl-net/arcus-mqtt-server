# Settings for docker compose: copy to .env (git ignores it) and fill in

# Home Assistant's Mosquitto app, with a login from its "logins" setting or a Home Assistant user
MQTT_URL=mqtt://homeassistant.local:1883
MQTT_USERNAME=
MQTT_PASSWORD=

ARCUS_BRIDGE_URL=
# API-server mode
ARCUS_API_KEY=
# Or client-bridge mode: ARCUS_PLACE_ID, plus ARCUS_USERNAME and ARCUS_PASSWORD
# ARCUS_PLACE_ID=
# ARCUS_USERNAME=
# ARCUS_PASSWORD=

# Fake devices instead of an Arcus account
# ARCUS_MOCK=1
