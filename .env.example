# Settings for docker compose: copy to .env (git ignores it) and fill in

# The Mosquitto container from docker-compose.yml. For another broker, such as
# Home Assistant's Mosquitto app, set its URL and a login
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=

ARCUS_BRIDGE_URL=
# API-server mode
ARCUS_API_KEY=
# Or client-bridge mode: ARCUS_PLACE_ID, plus ARCUS_USERNAME and ARCUS_PASSWORD
# ARCUS_PLACE_ID=
# ARCUS_USERNAME=
# ARCUS_PASSWORD=

# Prefix for topics and IDs. Give each place its own when several servers share
# a broker. Changing it makes Home Assistant see new devices, so leave an existing
# server's as it is
# DEVICE_ID_PREFIX=arcus

# Fake devices instead of an Arcus account
# ARCUS_MOCK=1
